<Window x:Class="Saw2Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saw II — Flesh &amp; Blood"
        Width="1100" Height="700"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0A0C0E" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,24,14,20">
          <Image Source="pack://application:,,,/Assets/logoLaunch.png"
                 Stretch="Uniform"
                 SnapsToDevicePixels="True"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 MaxHeight="118"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,20">
          <TextBlock x:Name="StatusInstall" Text="—" FontSize="11" Foreground="{StaticResource Mute}" TextWrapping="Wrap"/>
          <TextBlock x:Name="StatusLang" Text="" FontSize="11" Foreground="{StaticResource Mute}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,4,0,0">
            <Button x:Name="NavPlay" Style="{StaticResource NavBtn}" Content="PLAY" Click="Nav_Click" Tag="active"/>
            <Button x:Name="NavSetup" Style="{StaticResource NavBtn}" Content="SETUP / ISO" Click="Nav_Click"/>
            <Button x:Name="NavLanguage" Style="{StaticResource NavBtn}" Content="LANGUAGE" Click="Nav_Click"/>
            <Button x:Name="NavVideo" Style="{StaticResource NavBtn}" Content="VIDEO" Click="Nav_Click"/>
            <Button x:Name="NavAudio" Style="{StaticResource NavBtn}" Content="AUDIO" Click="Nav_Click"/>
            <Button x:Name="NavInput" Style="{StaticResource NavBtn}" Content="CONTROLS" Click="Nav_Click"/>
            <Button x:Name="NavMods" Style="{StaticResource NavBtn}" Content="MODS" Click="Nav_Click"/>
            <Button x:Name="NavAdvanced" Style="{StaticResource NavBtn}" Content="ADVANCED" Click="Nav_Click"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <!-- Billy fades in from the top-right; black left side leaves room for copy. -->
      <Image Source="pack://application:,,,/Assets/billy-corner.png"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Width="460"
             Stretch="Uniform"
             Opacity="0.72"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             Margin="0,-8,-8,0"/>
      <Grid Margin="36,28,36,24">
      <DockPanel x:Name="PanelPlay" Visibility="Visible">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="LblPlayTitle" Style="{StaticResource SectionTitle}" Text="Play"/>
          <TextBlock x:Name="LblPlaySub" Style="{StaticResource SectionSub}"
                     Text="Launch the game with your current settings. Install from ISO first if the game folder is empty."/>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom">
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock x:Name="LblExe" Style="{StaticResource FieldLabel}" Text="GAME BINARY"/>
              <TextBlock x:Name="TxtExe" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Bone}"/>
              <TextBlock x:Name="LblGameData" Style="{StaticResource FieldLabel}" Text="INSTALLED GAME FILES" Margin="0,12,0,4"/>
              <TextBlock x:Name="TxtGame" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Bone}"/>
              <TextBlock x:Name="LblPlayTip" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                         Text="Tip: set language, video and controls in the other tabs, then press Play. Settings are saved automatically when you launch."/>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnPlay" Style="{StaticResource PrimaryBtn}" Content="PLAY" Width="160" Click="Play_Click"/>
            <Button x:Name="BtnOpenFolder" Style="{StaticResource GhostBtn}" Content="Open game folder" Margin="12,0,0,0" Click="OpenGameFolder_Click"/>
            <Button x:Name="BtnSave" Style="{StaticResource GhostBtn}" Content="Save settings" Margin="12,0,0,0" Click="Save_Click"/>
          </StackPanel>
          <TextBlock x:Name="TxtPlayMsg" Margin="0,14,0,0" Foreground="{StaticResource Rust}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>

      <DockPanel x:Name="PanelSetup" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="LblSetupTitle" Style="{StaticResource SectionTitle}" Text="Install from ISO"/>
          <TextBlock x:Name="LblSetupSub" Style="{StaticResource SectionSub}"
                     Text="Point at your Xbox 360 ISO of Saw II: Flesh &amp; Blood. The launcher extracts it with extract-xiso and detects which languages the disc contains."/>
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="LblIso" Style="{StaticResource FieldLabel}" Text="ISO PATH"/>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtIso" Grid.Column="0"/>
            <Button x:Name="BtnBrowseIso" Grid.Column="1" Style="{StaticResource GhostBtn}" Content="Browse…" Margin="10,0,0,0" Padding="16,8" Click="BrowseIso_Click"/>
          </Grid>

          <TextBlock x:Name="LblInstallTo" Style="{StaticResource FieldLabel}" Text="INSTALL TO"/>
          <TextBox x:Name="TxtInstallTo" Margin="0,0,0,14" IsReadOnly="True"/>

          <TextBlock x:Name="LblXiso" Style="{StaticResource FieldLabel}" Text="EXTRACT-XISO"/>
          <TextBox x:Name="TxtXisoTool" Margin="0,0,0,18" IsReadOnly="True" FontFamily="Consolas" FontSize="12"/>

          <Button x:Name="BtnExtract" Style="{StaticResource PrimaryBtn}" Content="EXTRACT &amp; INSTALL" HorizontalAlignment="Left" Click="Install_Click"/>
          <ProgressBar x:Name="InstallProgress" Height="4" Margin="0,18,0,8" Minimum="0" Maximum="1" Value="0"
                       Foreground="{StaticResource Blood}" Background="{StaticResource Line}" BorderThickness="0"/>
          <TextBlock x:Name="TxtInstallStatus" Foreground="{StaticResource Mute}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>

      <ScrollViewer x:Name="PanelVideo" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,12">
          <TextBlock x:Name="LblVideoTitle" Style="{StaticResource SectionTitle}" Text="Video"/>
          <TextBlock x:Name="LblVideoSub" Style="{StaticResource SectionSub}" Text="Internal render, output size, frame rate and upscaling."/>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock x:Name="LblDisplayHead" Style="{StaticResource SectionHead}" Text="DISPLAY"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock x:Name="LblInternalRes" Style="{StaticResource FieldLabel}" Text="INTERNAL RESOLUTION"/>
                  <ComboBox x:Name="CmbInternalRes" SelectionChanged="InternalRes_Changed">
                    <ComboBoxItem Content="720p"/>
                    <ComboBoxItem Content="1080p" IsSelected="True"/>
                    <ComboBoxItem Content="1440p"/>
                    <ComboBoxItem Content="4k"/>
                    <ComboBoxItem Content="1280x720"/>
                    <ComboBoxItem Content="1920x1080"/>
                    <ComboBoxItem Content="2560x1440"/>
                    <ComboBoxItem Content="3840x2160"/>
                  </ComboBox>
                  <TextBlock x:Name="LblInternalHint" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                             Text="What the game draws. Lower = more FPS."/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock x:Name="LblOutputRes" Style="{StaticResource FieldLabel}" Text="OUTPUT RESOLUTION"/>
                  <ComboBox x:Name="CmbOutputRes" SelectionChanged="OutputRes_Changed">
                    <ComboBoxItem Content="720p"/>
                    <ComboBoxItem Content="1080p" IsSelected="True"/>
                    <ComboBoxItem Content="1440p"/>
                    <ComboBoxItem Content="4k"/>
                    <ComboBoxItem Content="1280x720"/>
                    <ComboBoxItem Content="1920x1080"/>
                    <ComboBoxItem Content="2560x1440"/>
                    <ComboBoxItem Content="3840x2160"/>
                  </ComboBox>
                  <TextBlock x:Name="LblOutputHint" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                             Text="Window / fullscreen on your monitor."/>
                  <TextBlock x:Name="TxtOutputPx" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,4,0,0" FontFamily="Consolas" Text="1920 × 1080"/>
                  <!-- Kept for code paths that still read width/height boxes. -->
                  <TextBox x:Name="TxtWinW" Text="1920" Visibility="Collapsed"/>
                  <TextBox x:Name="TxtWinH" Text="1080" Visibility="Collapsed"/>
                  <TextBlock x:Name="LblWinW" Visibility="Collapsed"/>
                  <TextBlock x:Name="LblWinH" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <CheckBox x:Name="ChkFullscreen" Content="Fullscreen" IsChecked="True" Margin="0,0,18,0"/>
                <CheckBox x:Name="ChkLetterbox" Content="Letterbox" IsChecked="True" Margin="0,0,18,0"/>
                <CheckBox x:Name="ChkDither" Content="Present dither"/>
              </StackPanel>
              <DockPanel Margin="0,10,0,0">
                <TextBlock x:Name="LblMonitor" Style="{StaticResource FieldLabel}" Text="MONITOR" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtMonitor" Text="0" Width="64" HorizontalAlignment="Left"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock x:Name="LblVsyncSection" Style="{StaticResource SectionHead}" Text="FRAME RATE"/>
              <TextBlock x:Name="LblFps" Style="{StaticResource FieldLabel}" Text="TARGET FPS"/>
              <ComboBox x:Name="CmbFpsPreset" Width="160" HorizontalAlignment="Left" SelectionChanged="FpsPreset_Changed">
                <ComboBoxItem Content="30" Tag="30"/>
                <ComboBoxItem Content="60" Tag="60" IsSelected="True"/>
              </ComboBox>
              <TextBlock x:Name="LblFpsHint" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,6,0,10" TextWrapping="Wrap"
                         Text="30 = original pacing. 60 = smoother. Higher rates make UE3 run accelerated."/>
              <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkVSync" Content="V-Sync" IsChecked="True" Margin="0,0,18,0"/>
                <CheckBox x:Name="ChkTearing" Content="Allow VRR / tearing"/>
              </StackPanel>
              <CheckBox x:Name="ChkClockNoScale" Content="Unlock guest clock" Visibility="Collapsed"/>
              <StackPanel x:Name="PanelCustomFps" Visibility="Collapsed">
                <TextBox x:Name="TxtRefresh" Text="60"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock x:Name="LblUpscale" Style="{StaticResource SectionHead}" Text="UPSCALING"/>
              <ComboBox x:Name="CmbPresentEffect" Width="220" HorizontalAlignment="Left" SelectionChanged="PresentEffect_Changed">
                <ComboBoxItem Content="bilinear" IsSelected="True"/>
                <ComboBoxItem Content="cas"/>
                <ComboBoxItem Content="fsr"/>
                <ComboBoxItem Content="fsr2"/>
                <ComboBoxItem Content="fsr3"/>
              </ComboBox>
              <TextBlock x:Name="TxtUpscaleNote" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,6,0,8" TextWrapping="Wrap"
                         Text="Use when output &gt; internal. Bilinear is safest; FSR/CAS need FidelityFX."/>

              <StackPanel x:Name="PanelFsr" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock x:Name="LblFsrQuality" Style="{StaticResource FieldLabel}" Text="FSR QUALITY MODE"/>
                <ComboBox x:Name="CmbFsrQuality" Width="220" HorizontalAlignment="Left" Margin="0,0,0,10">
                  <ComboBoxItem Content="auto" IsSelected="True"/>
                  <ComboBoxItem Content="ultra_quality"/>
                  <ComboBoxItem Content="quality"/>
                  <ComboBoxItem Content="balanced"/>
                  <ComboBoxItem Content="performance"/>
                </ComboBox>
                <TextBlock x:Name="LblFsrSharp" Style="{StaticResource FieldLabel}" Text="FSR SHARPNESS REDUCTION"/>
                <Slider x:Name="SldFsrSharp" Minimum="0" Maximum="1" Value="0.2" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtFsrSharp" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,0,0,10"/>
                <TextBlock x:Name="LblFsrPasses" Style="{StaticResource FieldLabel}" Text="FSR MAX UPSAMPLING PASSES"/>
                <TextBox x:Name="TxtFsrPasses" Text="4" Width="80" HorizontalAlignment="Left"/>
              </StackPanel>

              <StackPanel x:Name="PanelCas" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock x:Name="LblCasSharp" Style="{StaticResource FieldLabel}" Text="CAS ADDITIONAL SHARPNESS"/>
                <Slider x:Name="SldCasSharp" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtCasSharp" Foreground="{StaticResource Mute}" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel x:Name="PanelAudio" Visibility="Collapsed">
        <TextBlock x:Name="LblAudioTitle" Style="{StaticResource SectionTitle}" Text="Audio"/>
        <TextBlock x:Name="LblAudioSub" Style="{StaticResource SectionSub}" Text="Volume and buffering for the PC audio path."/>
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <CheckBox x:Name="ChkMute" Content="Mute"/>
            <TextBlock x:Name="LblAudioQueue" Style="{StaticResource FieldLabel}" Text="BUFFER (QUEUED FRAMES, 4–64)" Margin="0,10,0,4"/>
            <Slider x:Name="SldAudioQ" Minimum="4" Maximum="64" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" Width="280" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtAudioQ" Foreground="{StaticResource Mute}" Margin="0,4,0,0"/>
            <TextBlock x:Name="LblAudioHint" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Raise the buffer if you hear crackling; lower it for less latency."/>
          </StackPanel>
        </Border>
      </StackPanel>

      <ScrollViewer x:Name="PanelInput" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="LblInputTitle" Style="{StaticResource SectionTitle}" Text="Controls"/>
          <TextBlock x:Name="LblInputSub" Style="{StaticResource SectionSub}"
                     Text="Use a pad, or turn on mouse + keyboard and remap keys to Xbox buttons."/>

          <TextBlock x:Name="LblInputDeviceHead" Style="{StaticResource SectionHead}" Text="DEVICE" Margin="0,0,0,8"/>
          <TextBlock x:Name="LblInputBackend" Style="{StaticResource FieldLabel}" Text="CONTROLLER BACKEND"/>
          <ComboBox x:Name="CmbInputBackend" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
            <ComboBoxItem Content="sdl" IsSelected="True"/>
            <ComboBoxItem Content="xinput"/>
          </ComboBox>
          <CheckBox x:Name="ChkMnk" Content="Enable mouse + keyboard" Checked="Mnk_Changed" Unchecked="Mnk_Changed"/>
          <CheckBox x:Name="ChkMnkMouse" Content="Mouse looks / aims (camera = mouse, not arrow keys)" IsChecked="True"
                    Checked="Mnk_Changed" Unchecked="Mnk_Changed"/>
          <CheckBox x:Name="ChkGuide" Content="Pass through Guide / Xbox button"/>
          <TextBlock x:Name="LblSens" Style="{StaticResource FieldLabel}" Text="MOUSE LOOK SENSITIVITY" Margin="0,12,0,4"/>
          <Slider x:Name="SldSens" Minimum="0.5" Maximum="40" Value="3" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="320" HorizontalAlignment="Left"/>
          <TextBlock x:Name="TxtSens" Foreground="{StaticResource Mute}"/>
          <TextBlock x:Name="LblMouseLookHint" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="With mouse look on, camera rotation comes from the mouse. Right-stick keyboard binds are hidden and not sent."/>

          <Border x:Name="PanelKeybindsWrap" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,8,0,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button x:Name="BtnResetBinds" DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Content="Reset defaults" Padding="12,6" Click="ResetBinds_Click"/>
                <TextBlock x:Name="LblKeybindsHead" Style="{StaticResource SectionHead}" Text="REMAP KEYBOARD" Margin="0"/>
              </DockPanel>
              <TextBlock x:Name="LblKeybindsHint" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"
                         Text="Turn on mouse + keyboard above, then click a key slot and press a new key. Escape cancels. Works like remapping a pad — each Xbox button gets a keyboard key."/>
              <StackPanel x:Name="PanelKeybinds"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel x:Name="PanelLanguage" Visibility="Collapsed">
        <TextBlock x:Name="LblLangTitle" Style="{StaticResource SectionTitle}" Text="Language"/>
        <TextBlock x:Name="LblLangSub" Style="{StaticResource SectionSub}"
                   Text="Only languages present on your extracted ISO are listed. This also sets the entire launcher UI language."/>
        <TextBlock x:Name="LblLangField" Style="{StaticResource FieldLabel}" Text="GAME LANGUAGE (FROM ISO)"/>
        <ComboBox x:Name="CmbLanguage" Margin="0,0,0,14" DisplayMemberPath="DisplayName" SelectionChanged="Language_Changed"/>
        <Button x:Name="BtnRescanLang" Style="{StaticResource GhostBtn}" Content="Rescan ISO languages" HorizontalAlignment="Left" Padding="16,8" Click="RescanLang_Click"/>
        <TextBlock x:Name="TxtLangHint" Margin="0,16,0,0" Foreground="{StaticResource Mute}" TextWrapping="Wrap"/>
      </StackPanel>

      <ScrollViewer x:Name="PanelMods" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,12">
          <TextBlock x:Name="LblModsTitle" Style="{StaticResource SectionTitle}" Text="Mods"/>
          <TextBlock x:Name="LblModsSub" Style="{StaticResource SectionSub}" Text="Optional host overlays and boot tweaks."/>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock x:Name="LblMods" Style="{StaticResource SectionHead}" Text="HUD (experimental)"/>
              <CheckBox x:Name="ChkHudMod" Content="HUD overlay — experimental (health, syringes, items)"/>
              <TextBlock x:Name="LblHudHint" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Experimental. Host ImGui HUD — fades in after boot. Health fill may not bind reliably yet."/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock x:Name="LblAchievementsHead" Style="{StaticResource SectionHead}" Text="ACHIEVEMENTS"/>
              <CheckBox x:Name="ChkAchievements" Content="Enable achievements" IsChecked="True"/>
              <TextBlock x:Name="LblAchievementsHint" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="When on, unlocks persist under Documents\saw2\achievements and a safe text toast appears. When off, host unlocks are ignored."/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock x:Name="LblBoot" Style="{StaticResource SectionHead}" Text="BOOT"/>
              <CheckBox x:Name="ChkSkipBoot" Content="Skip startup logo movies (-nostartupmovies)"/>
              <TextBlock x:Name="LblSkipHint" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Passes UE3 -nostartupmovies on the guest command line. No .bik files are modified."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="PanelAdvanced" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,12">
          <TextBlock x:Name="LblAdvTitle" Style="{StaticResource SectionTitle}" Text="Advanced"/>
          <TextBlock x:Name="LblAdvSub" Style="{StaticResource SectionSub}" Text="Logging and raw ReXGlue flags."/>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock x:Name="LblLogHead" Style="{StaticResource SectionHead}" Text="LOGGING"/>
              <TextBlock x:Name="LblLogLevel" Style="{StaticResource FieldLabel}" Text="LOG LEVEL"/>
              <ComboBox x:Name="CmbLogLevel" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10">
                <ComboBoxItem Content="error"/>
                <ComboBoxItem Content="warn"/>
                <ComboBoxItem Content="info" IsSelected="True"/>
                <ComboBoxItem Content="debug"/>
                <ComboBoxItem Content="trace"/>
              </ComboBox>
              <CheckBox x:Name="ChkVerbose" Content="Verbose (--verbose)"/>
              <CheckBox x:Name="ChkLogFile" Content="Write log to Documents\saw2\saw2.log" IsChecked="True"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock x:Name="LblDevHead" Style="{StaticResource SectionHead}" Text="DEVELOPER"/>
              <TextBlock x:Name="LblCountry" Style="{StaticResource FieldLabel}" Text="USER COUNTRY ID"/>
              <TextBox x:Name="TxtCountry" Text="103" Width="100" HorizontalAlignment="Left" Margin="0,0,0,12"/>
              <TextBlock x:Name="LblExtra" Style="{StaticResource FieldLabel}" Text="EXTRA ARGS"/>
              <TextBox x:Name="TxtExtra" AcceptsReturn="False" FontFamily="Consolas"/>
              <TextBlock x:Name="LblExtraHint" Foreground="{StaticResource Mute}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                         Text="Space-separated flags appended as-is to the process command line."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>