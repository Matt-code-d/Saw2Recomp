<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Saw2Launcher</AssemblyName>
    <RootNamespace>Saw2Launcher</RootNamespace>
    <Product>Saw II Flesh and Blood Launcher</Product>
    <Version>0.1.5</Version>
    <ApplicationIcon>..\logoLaunch.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\logoLaunch.png" Link="Assets\logoLaunch.png" />
    <Resource Include="..\billy-corner.png" Link="Assets\billy-corner.png" />
    <None Include="..\logoLaunch.ico" Link="Assets\logoLaunch.ico" />
  </ItemGroup>
</Project>